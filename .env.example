# ============================================================
# Beacon MCP server — environment configuration
# ============================================================
# Copy to .env and fill in BEACON_MANIFEST_PATH.

# Required: path to your beacon.yaml manifest file.
BEACON_MANIFEST_PATH=/absolute/path/to/beacon.yaml

# Optional: root directory for resolving canonical doc paths listed in the
# manifest. Defaults to the directory containing beacon.yaml when not set.
# BEACON_DOCS_ROOT=/absolute/path/to/project

# Whether to hard-fail at startup when the manifest has validation errors.
# Set to false to start in degraded mode (warnings logged, tools still work).
# BEACON_VALIDATE_ON_LOAD=true

# Log level for the Beacon server process.
# BEACON_LOG_LEVEL=WARNING

# Host / port for remote (HTTP/SSE) transport. Ignored in stdio mode.
# BEACON_HOST=127.0.0.1
# BEACON_PORT=8788
