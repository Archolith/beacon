{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:archolith:beacon:schema:chunk-index:1.0",
  "title": "Beacon Chunk Index 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "chunk_index_version",
    "beacon_version",
    "snapshot",
    "item_url_template",
    "count",
    "documents"
  ],
  "properties": {
    "chunk_index_version": {"const": "1.0"},
    "beacon_version": {"type": "string", "minLength": 1},
    "snapshot": {"$ref": "#/$defs/snapshot"},
    "item_url_template": {"const": "/v1/chunks/{id}"},
    "count": {"type": "integer", "minimum": 0, "maximum": 10000},
    "documents": {
      "type": "array",
      "maxItems": 256,
      "items": {"$ref": "#/$defs/document"}
    }
  },
  "$defs": {
    "sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "chunkId": {"type": "string", "pattern": "^c1-[0-9a-f]{32}$"},
    "snapshot": {
      "type": "object",
      "additionalProperties": false,
      "required": ["sha256", "schema_version"],
      "properties": {
        "sha256": {"$ref": "#/$defs/sha256"},
        "schema_version": {"const": "1.0"}
      }
    },
    "document": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "chunks"],
      "properties": {
        "path": {"type": "string", "minLength": 1},
        "chunks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10000,
          "items": {"$ref": "#/$defs/chunk"}
        }
      }
    },
    "chunk": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "parent_role",
        "parent_status",
        "heading_path",
        "line_start",
        "line_end",
        "text_bytes",
        "bytes"
      ],
      "properties": {
        "id": {"$ref": "#/$defs/chunkId"},
        "parent_role": {"type": "string", "minLength": 1},
        "parent_status": {"type": "string", "minLength": 1},
        "heading_path": {
          "type": "array",
          "items": {"type": "string", "minLength": 1}
        },
        "line_start": {"type": "integer", "minimum": 1},
        "line_end": {"type": "integer", "minimum": 1},
        "text_bytes": {"type": "integer", "minimum": 0},
        "bytes": {"type": "integer", "minimum": 1}
      }
    }
  }
}
