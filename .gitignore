# Python bytecode / cache
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
.venv/
venv/
env/
ENV/

# Coverage
.coverage
.coverage.*
htmlcov/
coverage.xml

# Test / type / lint caches
.pytest_cache/
.mypy_cache/
.ruff_cache/
.pyre/
.pytype/
.tox/
.nox/

# Build / distribution / metadata
# (except the beacon.build package: the v0.3 pipeline lives at src/beacon/build/)
build/
!src/beacon/build/
!src/beacon/build/**
dist/
*.egg-info/
*.egg
wheels/

# CI/build scratch created in the local checkout (.deps framework bridge,
# wheel dirs, installed-wheel smoke venv, scratch outputs/checksums)
.deps/
.smoke/
.ci/

# Local environment / secrets
.env
.env.*
!.env.example
*.env
*.pem
*.key
*.p12
*.pfx

# Editor / OS junk
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Generated root/local snapshot artifacts
*.snapshot.json
*.snapshot.json.sha256

# Committed example snapshots remain allowed under examples/
!examples/**/*.snapshot.json
!examples/**/*.snapshot.json.sha256
